DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
GEMINI_API_KEY=paste-your-real-key-here

# "qr" = scan a QR code with your phone, "cloud" = official WhatsApp Cloud API
WHATSAPP_MODE=qr

# Only needed when WHATSAPP_MODE=cloud
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# WhatsApp number(s) that get a message when a call is booked
# Country code, no +. Several numbers: 923001234567,923007654321
OWNER_PHONE=

# When you take calls (Pakistan time); the bot only books free slots in these hours
CALL_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
CALL_START_HOUR=10
CALL_END_HOUR=19
CALL_MINUTES=30
